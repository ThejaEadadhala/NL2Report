{
  "database": "tpch",
  "tables": [
    {
      "name": "customer",
      "row_count": 150000,
      "columns": [
        {
          "name": "c_custkey",
          "type": "BIGINT",
          "pk": false,
          "description": "Unique customer identifier"
        },
        {
          "name": "c_name",
          "type": "VARCHAR",
          "pk": false,
          "description": "Customer name (e.g., Customer#000000001)"
        },
        {
          "name": "c_address",
          "type": "VARCHAR",
          "pk": false,
          "description": "Customer mailing address"
        },
        {
          "name": "c_nationkey",
          "type": "BIGINT",
          "pk": false,
          "description": "FK \u2014 nation where customer is located"
        },
        {
          "name": "c_phone",
          "type": "VARCHAR",
          "pk": false,
          "description": "Customer contact phone number"
        },
        {
          "name": "c_acctbal",
          "type": "VARCHAR",
          "pk": false,
          "description": "Customer account balance (negative means outstanding debt)"
        },
        {
          "name": "c_mktsegment",
          "type": "VARCHAR",
          "pk": false,
          "description": "Market segment (AUTOMOBILE, BUILDING, FURNITURE, HOUSEHOLD, MACHINERY)"
        },
        {
          "name": "c_comment",
          "type": "VARCHAR",
          "pk": false,
          "description": "Miscellaneous comment"
        },
        {
          "name": "c_has_debt",
          "type": "BIGINT",
          "pk": false,
          "description": "Derived \u2014 1 if c_acctbal < 0 (customer has debt), else 0"
        }
      ],
      "foreign_keys": [
        {
          "from": "c_nationkey",
          "to_table": "nation",
          "to_col": "n_nationkey"
        }
      ]
    },
    {
      "name": "lineitem",
      "row_count": 6001215,
      "columns": [
        {
          "name": "l_orderkey",
          "type": "BIGINT",
          "pk": false,
          "description": "FK \u2014 order this line item belongs to"
        },
        {
          "name": "l_partkey",
          "type": "BIGINT",
          "pk": false,
          "description": "FK \u2014 part ordered (also FK to partsupp via l_suppkey)"
        },
        {
          "name": "l_suppkey",
          "type": "BIGINT",
          "pk": false,
          "description": "FK \u2014 supplier fulfilling this line item"
        },
        {
          "name": "l_linenumber",
          "type": "BIGINT",
          "pk": false,
          "description": "Line number within the order (1-based)"
        },
        {
          "name": "l_quantity",
          "type": "VARCHAR",
          "pk": false,
          "description": "Quantity of parts ordered on this line"
        },
        {
          "name": "l_extendedprice",
          "type": "VARCHAR",
          "pk": false,
          "description": "Base price for this line (quantity \u00d7 part retail price, before discounts/tax)"
        },
        {
          "name": "l_discount",
          "type": "VARCHAR",
          "pk": false,
          "description": "Discount fraction applied to extended price (0.00\u20130.10)"
        },
        {
          "name": "l_tax",
          "type": "VARCHAR",
          "pk": false,
          "description": "Tax fraction applied after discount (0.00\u20130.08)"
        },
        {
          "name": "l_returnflag",
          "type": "VARCHAR",
          "pk": false,
          "description": "Return status: R=returned, A=accepted return, N=not returned"
        },
        {
          "name": "l_linestatus",
          "type": "VARCHAR",
          "pk": false,
          "description": "Line status: O=open (order not fulfilled), F=fulfilled"
        },
        {
          "name": "l_shipdate",
          "type": "VARCHAR",
          "pk": false,
          "description": "Date the item was shipped"
        },
        {
          "name": "l_commitdate",
          "type": "VARCHAR",
          "pk": false,
          "description": "Committed delivery date agreed with customer"
        },
        {
          "name": "l_receiptdate",
          "type": "VARCHAR",
          "pk": false,
          "description": "Date the item was actually received by the customer"
        },
        {
          "name": "l_shipinstruct",
          "type": "VARCHAR",
          "pk": false,
          "description": "Shipping instructions (DELIVER IN PERSON, COLLECT COD, NONE, TAKE BACK RETURN)"
        },
        {
          "name": "l_shipmode",
          "type": "VARCHAR",
          "pk": false,
          "description": "Shipping mode (AIR, FOB, MAIL, RAIL, REG AIR, SHIP, TRUCK)"
        },
        {
          "name": "l_comment",
          "type": "VARCHAR",
          "pk": false,
          "description": "Miscellaneous comment"
        },
        {
          "name": "l_net_revenue",
          "type": "VARCHAR",
          "pk": false,
          "description": "Derived \u2014 net revenue: l_extendedprice \u00d7 (1 - l_discount) \u00d7 (1 + l_tax)"
        },
        {
          "name": "l_ship_year",
          "type": "BIGINT",
          "pk": false,
          "description": "Derived \u2014 calendar year extracted from l_shipdate"
        },
        {
          "name": "l_ship_month",
          "type": "BIGINT",
          "pk": false,
          "description": "Derived \u2014 calendar month (1\u201312) extracted from l_shipdate"
        }
      ],
      "foreign_keys": [
        {
          "from": "l_orderkey",
          "to_table": "orders",
          "to_col": "o_orderkey"
        },
        {
          "from": "l_partkey",
          "to_table": "part",
          "to_col": "p_partkey"
        },
        {
          "from": "l_suppkey",
          "to_table": "supplier",
          "to_col": "s_suppkey"
        }
      ]
    },
